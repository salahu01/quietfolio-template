# Public canonical URL of the deployed site (origin + optional sub-path).
# Used for canonical links, sitemap, RSS, JSON-LD and social tags. REQUIRED for a real deployment.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Only when serving from a sub-path (GitHub Pages project site). Set automatically by `npm run deploy:pages`.
# NEXT_PUBLIC_BASE_PATH=/your-repo
# Set to 1 for demo/mirror deployments that must not be indexed.
# NEXT_PUBLIC_NOINDEX=1
